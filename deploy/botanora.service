# Botanora como serviço do systemd
# Instale em /etc/systemd/system/botanora.service e rode:
#   systemctl daemon-reload && systemctl enable --now botanora

[Unit]
Description=Botanora (botanora.cdev.com.br)
After=network.target

[Service]
Type=simple
User=botanora
Group=botanora
WorkingDirectory=/var/www/botanora
ExecStart=/usr/bin/node server.js
Environment=NODE_ENV=production
Restart=always
RestartSec=3
# Proteções básicas
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/www/botanora

[Install]
WantedBy=multi-user.target
