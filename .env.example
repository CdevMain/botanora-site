# Botânora: configuração
# Copie para .env (o servidor cria automaticamente no primeiro start).

PORT=3000
# Em produção atrás do Nginx use 127.0.0.1 (o site só fica acessível pelo proxy)
HOST=0.0.0.0
# URL pública do site (usada em links canônicos, sitemap e retorno do Mercado Pago)
SITE_URL=http://localhost:3000

# Painel /admin
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
SESSION_SECRET=gerado-automaticamente

CONTACT_EMAIL=contato@botanora.com.br

# PIX estático (copia e cola + QR). Deixe PIX_KEY vazio para desativar.
PIX_KEY=
PIX_MERCHANT_NAME=BOTANORA
PIX_MERCHANT_CITY=GUAIBA

# Mercado Pago Checkout Pro (opcional). Com o token preenchido, a compra
# redireciona ao Mercado Pago e o webhook confirma o pagamento automaticamente.
MP_ACCESS_TOKEN=
# Assinatura secreta do webhook (painel do Mercado Pago > Webhooks)
MP_WEBHOOK_SECRET=

# Cakto: cole aqui o "secret" do webhook (Cakto > Integrações > Webhooks).
# URL do webhook a cadastrar na Cakto: SITE_URL/api/webhooks/cakto
# Eventos: purchase_approved, refund, chargeback
CAKTO_WEBHOOK_SECRET=

# E-mail de acesso (opcional) pela Resend (https://resend.com)
# Com isso o cliente recebe o link da biblioteca no idioma da compra.
RESEND_API_KEY=
MAIL_FROM="Botânora <guias@seudominio.com.br>"

# Validade (dias) do link de acesso à biblioteca
ACCESS_DAYS=365

# Downloads permitidos por pedido pago
MAX_DOWNLOADS=10

# 1 se estiver atrás de Nginx/Cloudflare (usa X-Forwarded-For)
TRUST_PROXY=0

# Google Analytics 4 e Microsoft Clarity. Só carregam se o visitante aceitar os cookies.
# Deixe vazio para desativar.
GA_ID=G-VC1F9QT587
CLARITY_ID=yyqohzc7o5

# Busca: códigos de verificação (só o valor do content da meta tag)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Chave do IndexNow (avisa Bing, Copilot e outros buscadores quando páginas mudam). Gerada automaticamente se vazia.
INDEXNOW_KEY=
