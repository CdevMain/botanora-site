# Botânora: configuração
# Copie para .env (o servidor cria automaticamente no primeiro start).

PORT=3000
# Em produção atrás do Nginx use 127.0.0.1 (o site só fica acessível pelo proxy)
HOST=0.0.0.0
# URL pública do site (usada em links canônicos, sitemap e e-mails)
SITE_URL=http://localhost:3000

# Painel /admin
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
SESSION_SECRET=gerado-automaticamente

CONTACT_EMAIL=contato@botanora.com.br

# Cakto: cole aqui o "secret" do webhook (Cakto > Integrações > Webhooks).
# URL do webhook a cadastrar na Cakto: SITE_URL/api/webhooks/cakto
# Eventos: purchase_approved, refund, chargeback
CAKTO_WEBHOOK_SECRET=

# E-mail de acesso (opcional) pela Resend (https://resend.com)
# Com isso o cliente recebe um link de entrada (uso único) no idioma da compra.
RESEND_API_KEY=
MAIL_FROM="Botânora <guias@botanora.cdev.com.br>"

# Por quantos dias um aparelho fica conectado à biblioteca depois de entrar
ACCESS_DAYS=365

# Quantos aparelhos podem ficar conectados ao mesmo e-mail (o mais antigo sai)
MAX_DEVICES=5

# Downloads permitidos por pedido pago
MAX_DOWNLOADS=10

# 1 se estiver atrás de Nginx/Cloudflare (usa X-Forwarded-For)
TRUST_PROXY=0

# Google Analytics 4 e Microsoft Clarity. Só carregam se o visitante aceitar os cookies.
# Deixe vazio para desativar.
GA_ID=G-VC1F9QT587
CLARITY_ID=yyqohzc7o5

# Busca: códigos de verificação (só o valor do content da meta tag)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Chave do IndexNow (avisa Bing, Copilot e outros buscadores quando páginas mudam). Gerada automaticamente se vazia.
INDEXNOW_KEY=

# Meta Ads (painel > Marketing e campanhas). Token de usuário do sistema com ads_read e ads_management.
# Nunca coloque o token no git: só no .env da VPS.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Opcional: assina as chamadas (appsecret_proof)
META_APP_SECRET=
# Opcional: Pixel no site (só com consentimento de cookies) e Conversions API (compra enviada pelo servidor
# quando a Cakto confirma o pagamento). Se META_CAPI_TOKEN ficar vazio, usa o META_ACCESS_TOKEN.
META_PIXEL_ID=
META_CAPI_TOKEN=
# Opcional: código de "Testar eventos" do Gerenciador de Eventos
META_TEST_EVENT_CODE=
META_API_VERSION=v25.0
